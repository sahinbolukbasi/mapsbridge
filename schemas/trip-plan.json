{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StructuredTripPlan",
  "description": "AWS Bedrock AgentCore seyahat asistanı için gün gün yapılandırılmış seyahat planı şeması",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string",
      "description": "Benzersiz seyahat kimliği",
      "maxLength": 64
    },
    "days": {
      "type": "array",
      "description": "Gün gün plan blokları",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "description": "Tarih (YYYY-MM-DD)"
          },
          "weather_note": {
            "type": "string",
            "description": "Günün hava durumu ve hazırlık notu"
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "time": {
                  "type": "string",
                  "description": "Zaman dilimi (örn: 09:00-10:00)"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "cafe",
                    "restaurant",
                    "museum",
                    "park",
                    "hotel",
                    "activity",
                    "transit",
                    "viewpoint"
                  ]
                },
                "place_id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "why": {
                  "type": "string",
                  "description": "Kullanıcının tercihlerine göre seçim nedeni"
                },
                "transit": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": ["walking", "subway", "bus", "taxi"]
                    },
                    "minutes": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": ["mode", "minutes"],
                  "additionalProperties": false
                },
                "est_cost": {
                  "type": "number",
                  "minimum": 0
                },
                "alt": {
                  "type": "string",
                  "description": "Hava koşulu veya kapanma durumundaki alternatif plan"
                }
              },
              "required": ["time", "type", "place_id", "name", "why"],
              "additionalProperties": false
            }
          }
        },
        "required": ["date", "weather_note", "blocks"],
        "additionalProperties": false
      }
    },
    "budget_summary": {
      "type": "object",
      "properties": {
        "total": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "maxLength": 10
        },
        "by_category": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      },
      "required": ["total", "currency"],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["trip_id", "days", "budget_summary", "sources"],
  "additionalProperties": false
}
