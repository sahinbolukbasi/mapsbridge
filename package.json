{
  "name": "location-root",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "dev:admin": "npm --prefix apps/admin run dev",
    "build": "npm --prefix apps/web run build",
    "build:admin": "npm --prefix apps/admin run build",
    "typecheck": "npm --prefix apps/web run typecheck",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "typecheck:admin": "npm --prefix apps/admin run typecheck",
    "typecheck:backend": "tsc --noEmit -p infra/lambda/tsconfig.json",
    "typecheck:all": "npm run typecheck:web && npm run typecheck:admin && npm run typecheck:backend",
    "test": "node --test apps/web/tests/*.test.cjs",
    "test:web": "node --test apps/web/tests/*.test.cjs",
    "test:backend": "node --test infra/lambda/tests/*.test.cjs",
    "test:services": "node --test services/ai-assistant/tests/*.test.cjs services/messaging/tests/*.test.cjs services/place-intelligence/tests/*.test.cjs",
    "test:all": "node --test apps/web/tests/*.test.cjs infra/lambda/tests/*.test.cjs services/ai-assistant/tests/*.test.cjs services/messaging/tests/*.test.cjs services/place-intelligence/tests/*.test.cjs",
    "test:coverage": "node --test --experimental-test-coverage apps/web/tests/*.test.cjs infra/lambda/tests/*.test.cjs services/ai-assistant/tests/*.test.cjs services/messaging/tests/*.test.cjs services/place-intelligence/tests/*.test.cjs",
    "eval:ai": "node infra/scripts/evaluate-ai-dialogues.cjs",
    "eval:golden": "node infra/scripts/evaluate-ai-dialogues.cjs --golden",
    "eval:golden:validate": "node infra/scripts/validate-golden-eval.cjs",
    "smoke:preflight": "node infra/scripts/verify-live-ai-prerequisites.cjs",
    "monitor:synthetics": "node monitoring/synthetics/canary-runner.cjs",
    "monitor:typecheck": "tsc -p monitoring/tsconfig.json --noEmit",
    "mobile:start": "npm --prefix apps/mobile start",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:typecheck": "tsc --noEmit --project apps/mobile/tsconfig.json",
    "mobile:bundle:ios": "npm --prefix apps/mobile exec -- expo export:embed --platform ios --dev false --entry-file index.ts --bundle-output ios/main.jsbundle --assets-dest ios",
    "mobile:export": "npm --prefix apps/mobile run export:ios && npm --prefix apps/mobile run export:android",
    "mobile:export:ios": "npm --prefix apps/mobile run export:ios",
    "mobile:export:android": "npm --prefix apps/mobile run export:android",
    "expo:start": "npm --prefix apps/mobile start",
    "expo:ios": "npm --prefix apps/mobile run ios",
    "expo:android": "npm --prefix apps/mobile run android",
    "polar:sync": "node scripts/polar-cli.mjs sync",
    "polar:list": "node scripts/polar-cli.mjs list",
    "secrets:upload": "node scripts/upload-polar-secrets.mjs",
    "deploy:prod": "./scripts/deploy-production.sh",
    "docker:build": "docker build -t mapsbridge:latest .",
    "docker:run": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ui:audit": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/ui-audit/cli.ts",
    "ui:audit:typecheck": "tsc -p scripts/ui-audit/tsconfig.json",
    "new:page": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/design-system/new-page.ts",
    "admin:mock": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/admin-mock/server.ts",
    "tokens:build": "npm --workspace @mapsbridge/design-tokens run build",
    "tokens:check": "npm --workspace @mapsbridge/design-tokens run check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "1.63.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  }
}
