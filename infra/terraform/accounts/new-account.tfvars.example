# ─── New AWS Account — tfvars template ────────────────────────────────────
# Copy to: accounts/<account-name>.tfvars
# Usage:   ../scripts/deploy-to-account.sh --profile <aws-profile> --tfvars accounts/<account-name>.tfvars

aws_region  = "eu-central-1"
environment = "prod"
project     = "mapsbridge"

# Domain
frontend_domain    = "app.example.com"
acm_certificate_arn = ""       # us-east-1 cert ARN for CloudFront custom domain
hosted_zone_id     = ""        # Route53 hosted zone ID (optional, skip if using external DNS)

# Budget
monthly_budget_usd  = "100"
budget_alert_email  = "devops@example.com"

# Database
db_username = "mapsbridge_admin"
# db_password is managed by Aurora Secrets Manager (manage_master_user_password=true)

# AI
bedrock_model_id       = "anthropic.claude-3-haiku-20240307-v1:0"
ai_daily_request_limit = 500

# Stripe (optional — leave empty to disable payments)
stripe_secret_key     = ""
stripe_webhook_secret = ""
stripe_price_ids      = {}

# Performance
lambda_timeout  = 28
lambda_memory   = 256
gateway_burst_limit = 50
gateway_rate_limit  = 25
waf_rate_limit      = 2000
