# Remote S3 backend — copy to backend.tf and fill in values for each account.
# Each account/environment pair needs its own S3 bucket and DynamoDB table.
#
# Bootstrap commands (run once per account before terraform init):
#   aws s3 mb s3://mapsbridge-tfstate-<ACCOUNT_ID> --region eu-central-1
#   aws dynamodb create-table \
#     --table-name mapsbridge-tfstate-lock \
#     --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH \
#     --billing-mode PAY_PER_REQUEST \
#     --region eu-central-1

terraform {
  backend "s3" {
    bucket         = "mapsbridge-tfstate-<ACCOUNT_ID>"
    key            = "<ENVIRONMENT>/terraform.tfstate"
    region         = "eu-central-1"
    dynamodb_table = "mapsbridge-tfstate-lock"
    encrypt        = true
  }
}
