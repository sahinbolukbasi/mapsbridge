# RevenueCat Configuration — set as GitHub Secrets (REVENUECAT_SECRET_KEY, REVENUECAT_WEBHOOK_SECRET)
# Project ID: projb29ddf07

rc_secret_api_key     = "YOUR_REVENUECAT_SECRET_KEY_FROM_GITHUB_SECRETS"
rc_webhook_auth_secret = "YOUR_REVENUECAT_WEBHOOK_SECRET_FROM_GITHUB_SECRETS"

# RevenueCat Product IDs
rc_explorer_product_id    = "prode1930276ca"   # Monthly
rc_pro_product_id         = "prod99e16b0cb7"   # Yearly  
rc_agency_product_id      = "prod742c37a698"   # Lifetime

# Package IDs (standard RevenueCat package identifiers)
rc_package_monthly  = "$rc_monthly"
rc_package_annual   = "$rc_annual"
rc_package_lifetime = "$rc_lifetime"

# Offering ID
rc_offering_id = "ofrng762b1657ce"

# Web checkout URL
rc_billing_checkout_url = "https://billing.revenuecat.com/projects/projb29ddf07"

# Environment
billing_enabled = "true"
app_origin      = "https://mapsbridge.com"
