aws_region  = "eu-central-1"
environment = "prod"
project     = "mapsbridge"

# Domain (optional — skip for CloudFront default domain)
frontend_domain     = "app.mapsbridge.com"
acm_certificate_arn = ""    # ACM cert ARN in us-east-1 for CloudFront
hosted_zone_id      = ""    # Route53 hosted zone ID

# Budget
monthly_budget_usd = "100"
budget_alert_email = "devops@mapsbridge.com"

# Database
db_username = "mapsbridge_admin"
db_password = "REPLACE_WITH_STRONG_PASSWORD"

# AI / Bedrock
bedrock_model_id       = "anthropic.claude-3-haiku-20240307-v1:0"
ai_daily_request_limit = 500

# Stripe (leave empty to disable)
stripe_secret_key     = ""
stripe_webhook_secret = ""
stripe_price_ids      = {}

# Performance / rate limits
lambda_timeout      = 28
lambda_memory       = 256
gateway_burst_limit = 50
gateway_rate_limit  = 25
waf_rate_limit      = 2000
