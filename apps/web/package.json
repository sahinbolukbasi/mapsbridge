{
  "name": "mapsbridge-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:ai && next build",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "build:ai": "esbuild ../../infra/lambda/src/ai/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=../../infra/terraform/.build/ai/handler.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:mobile": "playwright test"
  },
  "dependencies": {
    "jose": "*",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1134.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1141.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1127.0",
    "@aws-sdk/client-dynamodb": "^3.1141.0",
    "@aws-sdk/client-geo-places": "^3.1134.0",
    "@aws-sdk/credential-provider-node": "^3.972.84",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@smithy/hash-node": "^4.5.2",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.4",
    "next": "16.3.4",
    "qrcode.react": "^4.2.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/google.maps": "^3.66.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "esbuild": "^0.28.2",
    "leaflet": "^1.9.4",
    "typescript": "^7"
  }
}
