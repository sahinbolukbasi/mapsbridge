# ==========================================
# MapsBridge Web Ortam Değişkenleri
# ==========================================

# Google Identity Services / Google OAuth Client ID
# Google Cloud Console (https://console.cloud.google.com/) -> APIs & Services -> Credentials
# "Authorized JavaScript origins": http://localhost:3000, https://yourdomain.com
# "Authorized redirect URIs": http://localhost:3000/auth/callback, https://yourdomain.com/auth/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Opsiyonel: AWS Cognito Hosted UI Domain (Kendi domaininiz veya Cognito alt alanı)
NEXT_PUBLIC_COGNITO_DOMAIN=mapsbridge-auth.auth.eu-central-1.amazoncognito.com

# Google Maps Platform: restricted browser key, NOT the Google Sign-In client ID.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# AWS Cognito Client ID
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# API Base URL
NEXT_PUBLIC_API_BASE_URL=

# Super Admin Listesi (virgülle ayrılmış e-posta adresleri — session API hata verdiğinde client-side fallback)
NEXT_PUBLIC_SUPER_ADMINS=
