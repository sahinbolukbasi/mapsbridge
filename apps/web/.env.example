# ==========================================
# MapsBridge Web — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.
# ==========================================

# Google OAuth 2.0 Client ID (public — does NOT contain a client secret)
# Create at: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# AWS Cognito — region and pool identifiers (public)
NEXT_PUBLIC_COGNITO_REGION=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=

# Canonical site URL used for redirects and canonical tags
NEXT_PUBLIC_SITE_URL=

# Google Maps Platform — JavaScript Maps API key (public, restrict to your domain)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Super admin email list (comma-separated)
NEXT_PUBLIC_SUPER_ADMINS=

# AI Streaming Lambda Function URL (SSE streaming chat endpoint)
NEXT_PUBLIC_AI_STREAM_URL=

# REST API base URL (execute-api endpoint)
NEXT_PUBLIC_API_BASE_URL=

# Affiliate — Travelpayouts public tracking marker (not a secret)
NEXT_PUBLIC_TP_MARKER=

# GetYourGuide Partner ID (leave blank until assigned)
NEXT_PUBLIC_GYG_PARTNER_ID=

# Feature Flags
# false = legacy trip engine, true = new Trip domain engine
NEXT_PUBLIC_NEW_TRIP_ENGINE=false
