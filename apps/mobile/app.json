{
  "expo": {
    "name": "Maps Bridge",
    "slug": "mapsbridge",
    "scheme": "mapsbridge",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "locales": {
      "tr": "./locales/tr.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mapsbridge.mobile",
      "buildNumber": "19",
      "userInterfaceStyle": "dark",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "tr",
        "NSLocationWhenInUseUsageDescription": "Maps Bridge, “Yakınımda” ve haritada konumunu göstermek için uygulamayı kullanırken konumuna erişir. Konumun sunucuda saklanmaz.",
        "NSCameraUsageDescription": "Topluluk paylaşımına fotoğraf çekebilmen için kamera erişimi gerekir.",
        "NSPhotoLibraryUsageDescription": "Topluluk paylaşımına ve profil fotoğrafına görsel ekleyebilmen için fotoğraflarına erişilir.",
        "NSPhotoLibraryAddUsageDescription": "Rota ve harita görsellerini galerine kaydedebilmen için izin gerekir.",
        "NSFaceIDUsageDescription": "Açtığında uygulama kilidini Face ID ile açabilmen için kullanılır.",
        "NSMotionUsageDescription": "Maps Bridge hareket verini toplamaz; bu izin yalnızca konum bileşeninin içerdiği sistem kütüphanesi gereği istenir ve etkin olarak kullanılmaz."
      },
      "config": {
        "googleMapsApiKey": ""
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePreciseLocation",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.mapsbridge.mobile",
      "versionCode": 19,
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#020e0a"
      },
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "INTERNET",
        "POST_NOTIFICATIONS",
        "USE_BIOMETRIC",
        "VIBRATE"
      ],
      "blockedPermissions": ["android.permission.ACCESS_BACKGROUND_LOCATION"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mapsbridge.com",
              "pathPrefix": "/k/"
            },
            {
              "scheme": "https",
              "host": "mapsbridge.com",
              "pathPrefix": "/traveler/"
            },
            {
              "scheme": "https",
              "host": "mapsbridge.com",
              "pathPrefix": "/maps/"
            },
            {
              "scheme": "https",
              "host": "www.mapsbridge.com",
              "pathPrefix": "/k/"
            },
            {
              "scheme": "https",
              "host": "www.mapsbridge.com",
              "pathPrefix": "/traveler/"
            },
            {
              "scheme": "https",
              "host": "www.mapsbridge.com",
              "pathPrefix": "/maps/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Maps Bridge, “Yakınımda” ve haritada konumunu göstermek için uygulamayı kullanırken konumuna erişir. Konumun sunucuda saklanmaz.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "Maps Bridge hareket verini toplamaz; bu izin yalnızca konum bileşeninin içerdiği sistem kütüphanesi gereği istenir ve etkin olarak kullanılmaz.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "./plugins/without-push-entitlement.js",
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Açtığında uygulama kilidini Face ID ile açabilmen için kullanılır."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Topluluk paylaşımına ve profil fotoğrafına görsel ekleyebilmen için fotoğraflarına erişilir.",
          "cameraPermission": "Topluluk paylaşımına fotoğraf çekebilmen için kamera erişimi gerekir.",
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "https://pwi1j8mq0j.execute-api.eu-central-1.amazonaws.com",
      "eas": {
        "projectId": "1d5b0238-eed2-450a-9777-06eed2a42303"
      }
    },
    "owner": "sahinbolukbasi"
  }
}
