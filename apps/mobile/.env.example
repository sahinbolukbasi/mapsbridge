# RevenueCat API Keys — from RevenueCat dashboard Project Settings
EXPO_PUBLIC_RC_API_KEY_IOS=your_revenuecat_ios_public_key
EXPO_PUBLIC_RC_API_KEY_ANDROID=your_revenuecat_android_public_key

# RevenueCat Product & Package IDs (fetched from API)
# Products: Monthly (prode1930276ca), Yearly (prod99e16b0cb7), Lifetime (prod742c37a698)
# Packages: $rc_monthly, $rc_annual, $rc_lifetime
# Offering: ofrng762b1657ce (default)
# Entitlement: mapsbridge_pro (entl39bf296e8c)

# Google Maps & OAuth
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id

# API endpoints
EXPO_PUBLIC_API_BASE_URL=https://api.mapsbridge.com
