# RevenueCat API Keys — get from RevenueCat dashboard Project Settings → API keys
EXPO_PUBLIC_RC_API_KEY_IOS=your_ios_api_key_here
EXPO_PUBLIC_RC_API_KEY_ANDROID=your_android_api_key_here

# Google Maps & OAuth
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id

# API endpoints
EXPO_PUBLIC_API_BASE_URL=https://api.mapsbridge.com
